    {"id": "accurate", "option": "rr_mode", "head": "exact", "input": "exact", "body": "relaxed", "output": "default", "resolve": "exact"},
    {"id": "fast", "option": "rr_mode", "head": "relaxed", "input": "lite", "body": "relaxed", "output": "fast", "resolve": "hw"}
