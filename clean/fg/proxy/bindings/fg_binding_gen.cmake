# Frame generation title bindings (issue #96, F8b): reads a title-binding JSON (schema wronggpu.fg-proxy.title-binding.v1)
# and the files it names (the RR binding for the interface's export names and shared GUIDs, the interface file name,
# the FG feature-function names) and writes one C header of macros into the build tree. The names stay in the binding
# data; the C++ refers to them only through the generated macros (win32/fg_title_bindings.cpp).
#   wg_fg_generate_binding(<json> <out_header> <PREFIX>)
# Needs CMake 3.19 (string(JSON)). Every missing or malformed value stops the configure step.

set(WG_FG_ROLE_WORDS is-supported requirements get-function tag tag-for-frame constants evaluate free is-loaded set-loaded)
set(WG_FG_ROLE_MACROS IS_SUPPORTED REQUIREMENTS GET_FUNCTION TAG TAG_FOR_FRAME CONSTANTS EVALUATE FREE IS_LOADED SET_LOADED)
set(WG_FG_INPUT_ROLES backbuffer motion depth hudless ui_alpha distortion no_warp)
set(WG_FG_OPTIONAL_ROLES hudless ui_alpha distortion no_warp)

function(wg_fg_json_get out json what)
  string(JSON v ERROR_VARIABLE err GET "${json}" ${ARGN})
  if(err)
    message(FATAL_ERROR "fg title binding: ${what}: ${err}")
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(wg_fg_check_guid what text)
  # CMake regular expressions have no {n} counts
  string(REPEAT "[0-9a-f]" 4 h4)
  string(REPEAT "[0-9a-f]" 8 h8)
  string(REPEAT "[0-9a-f]" 12 h12)
  if(NOT text MATCHES "^${h8}-${h4}-${h4}-${h4}-${h12}$")
    message(FATAL_ERROR "fg title binding: ${what}: not a lower-case GUID: '${text}'")
  endif()
endfunction()

function(wg_fg_check_uint what v)
  if(NOT v MATCHES "^[0-9]+$")
    message(FATAL_ERROR "fg title binding: ${what}: not an unsigned number: '${v}'")
  endif()
endfunction()

function(wg_fg_generate_binding json_path out_header P)
  get_filename_component(dir "${json_path}" DIRECTORY)
  file(READ "${json_path}" j)
  set(deps "${json_path}")
  wg_fg_json_get(schema "${j}" "schema" schema)
  if(NOT schema STREQUAL "wronggpu.fg-proxy.title-binding.v1")
    message(FATAL_ERROR "fg title binding: ${json_path}: schema '${schema}'")
  endif()
  set(L "")
  macro(def name value)
    string(APPEND L "#define WG_FG_TB_${P}_${name} ${value}\n")
  endmacro()
  macro(defs name value)
    string(APPEND L "#define WG_FG_TB_${P}_${name} \"${value}\"\n")
  endmacro()

  foreach(k id title exe_leaf transport)
    wg_fg_json_get(v "${j}" "${k}" ${k})
    string(TOUPPER "${k}" K)
    defs(${K} "${v}")
  endforeach()
  wg_fg_json_get(q "${j}" "qualified" qualified)
  if(q STREQUAL "ON" OR q STREQUAL "TRUE" OR q STREQUAL "true")
    def(QUALIFIED 1)
  else()
    def(QUALIFIED 0)
  endif()
  wg_fg_json_get(dyn "${j}" "dynamic_supported" dynamic_supported)
  if(dyn STREQUAL "ON" OR dyn STREQUAL "TRUE" OR dyn STREQUAL "true")
    def(DYNAMIC_SUPPORTED 1)
  else()
    def(DYNAMIC_SUPPORTED 0)
  endif()

  # the interface: file name, version gate, export name per role, shared GUIDs (the RR binding's)
  wg_fg_json_get(iface_rel "${j}" "interface_file" interface_file)
  file(READ "${dir}/${iface_rel}" ij)
  list(APPEND deps "${dir}/${iface_rel}")
  wg_fg_json_get(leaf "${ij}" "interface_file.file_name" "file_name")
  defs(INTERFACE_LEAF "${leaf}")
  wg_fg_json_get(vmaj "${j}" "interface_version" interface_version 0)
  wg_fg_json_get(vmin "${j}" "interface_version" interface_version 1)
  wg_fg_check_uint(interface_version "${vmaj}")
  wg_fg_check_uint(interface_version "${vmin}")
  def(INTERFACE_MAJOR ${vmaj}u)
  def(INTERFACE_MINOR ${vmin}u)
  # optional: a generic binding's highest minor version of the same major (default: exactly interface_version)
  string(JSON vmax ERROR_VARIABLE vmaxerr GET "${j}" interface_version_minor_max)
  if(vmaxerr OR vmax STREQUAL "" OR vmax STREQUAL "NOTFOUND")
    set(vmax "${vmin}")
  endif()
  wg_fg_check_uint(interface_version_minor_max "${vmax}")
  if(vmax LESS vmin)
    message(FATAL_ERROR "fg title binding: interface_version_minor_max ${vmax} is below the minor version ${vmin}")
  endif()
  def(INTERFACE_MINOR_MAX ${vmax}u)
  # optional: the exe's DXGI factory creations carry the swap-chain hook when no importer creates the factory through
  # the interface module (default: off)
  string(JSON dff ERROR_VARIABLE dfferr GET "${j}" dxgi_factory_fallback)
  if(NOT dfferr AND (dff STREQUAL "ON" OR dff STREQUAL "TRUE" OR dff STREQUAL "true"))
    def(DXGI_FACTORY_FALLBACK 1)
  else()
    def(DXGI_FACTORY_FALLBACK 0)
  endif()
  wg_fg_json_get(rr_rel "${j}" "interface_binding" interface_binding)
  file(READ "${dir}/${rr_rel}" rj)
  list(APPEND deps "${dir}/${rr_rel}")
  foreach(word mac IN ZIP_LISTS WG_FG_ROLE_WORDS WG_FG_ROLE_MACROS)
    wg_fg_json_get(nm "${rj}" "interface_binding.roles.${word}" roles ${word})
    defs(ROLE_${mac} "${nm}")
  endforeach()
  foreach(g viewport tag resource constants requirements)
    wg_fg_json_get(gv "${rj}" "interface_binding.guids.${g}" guids ${g})
    wg_fg_check_guid("guids.${g}" "${gv}")
    string(TOUPPER "${g}" G)
    defs(GUID_${G} "${gv}")
  endforeach()

  # the FG feature-function names, by role
  wg_fg_json_get(fn_rel "${j}" "functions_file" functions_file)
  file(READ "${dir}/${fn_rel}" fj)
  list(APPEND deps "${dir}/${fn_rel}")
  wg_fg_json_get(fschema "${fj}" "functions_file.schema" schema)
  if(NOT fschema STREQUAL "wronggpu.fg-proxy.fg-functions.v1")
    message(FATAL_ERROR "fg title binding: ${fn_rel}: schema '${fschema}'")
  endif()
  string(JSON nroles LENGTH "${fj}" roles)
  string(JSON nnames LENGTH "${fj}" names)
  if(NOT nroles EQUAL nnames)
    message(FATAL_ERROR "fg title binding: ${fn_rel}: roles and names differ in length")
  endif()
  set(have_state OFF)
  set(have_options OFF)
  math(EXPR last "${nroles} - 1")
  foreach(i RANGE ${last})
    wg_fg_json_get(r "${fj}" "functions_file.roles" roles ${i})
    wg_fg_json_get(n "${fj}" "functions_file.names" names ${i})
    if(r STREQUAL "fg-state")
      defs(FN_STATE "${n}")
      set(have_state ON)
    elseif(r STREQUAL "fg-options")
      defs(FN_OPTIONS "${n}")
      set(have_options ON)
    else()
      message(FATAL_ERROR "fg title binding: ${fn_rel}: unknown role '${r}'")
    endif()
  endforeach()
  if(NOT have_state OR NOT have_options)
    message(FATAL_ERROR "fg title binding: ${fn_rel}: fg-state and fg-options are both required")
  endif()

  # numbers
  foreach(k fg_feature abi_max_generated ui_max_generated constants_min_version min_size)
    wg_fg_json_get(v "${j}" "${k}" ${k})
    wg_fg_check_uint(${k} "${v}")
    string(TOUPPER "${k}" K)
    def(${K} ${v}u)
  endforeach()
  wg_fg_json_get(fac "${j}" "factory_import" factory_import)
  defs(FACTORY_IMPORT "${fac}")
  foreach(s options state)
    wg_fg_json_get(gv "${j}" "${s}.guid" ${s} guid)
    wg_fg_check_guid("${s}.guid" "${gv}")
    wg_fg_json_get(ver "${j}" "${s}.version" ${s} version)
    wg_fg_json_get(sz "${j}" "${s}.size" ${s} size)
    wg_fg_check_uint("${s}.version" "${ver}")
    wg_fg_check_uint("${s}.size" "${sz}")
    string(TOUPPER "${s}" S)
    defs(GUID_${S} "${gv}")
    def(${S}_VERSION ${ver}u)
    def(${S}_SIZE ${sz}u)
  endforeach()
  set(mask 0)
  string(JSON np LENGTH "${j}" presets)
  if(np GREATER 0)
    math(EXPR plast "${np} - 1")
    foreach(i RANGE ${plast})
      wg_fg_json_get(p "${j}" presets presets ${i})
      if(p STREQUAL "A")
        math(EXPR mask "${mask} | 1")
      elseif(p STREQUAL "B")
        math(EXPR mask "${mask} | 2")
      elseif(p STREQUAL "C")
        math(EXPR mask "${mask} | 4")
      else()
        message(FATAL_ERROR "fg title binding: presets: unknown preset '${p}'")
      endif()
    endforeach()
  endif()
  def(PRESETS_MASK ${mask}u)
  foreach(role ${WG_FG_INPUT_ROLES})
    string(TOUPPER "${role}" R)
    string(JSON bt ERROR_VARIABLE berr GET "${j}" buffer_types ${role})
    if(berr OR bt STREQUAL "" OR bt STREQUAL "NOTFOUND")
      def(BT_${R} 0xffffffffu)
    else()
      wg_fg_check_uint("buffer_types.${role}" "${bt}")
      def(BT_${R} ${bt}u)
    endif()
  endforeach()
  foreach(role ${WG_FG_OPTIONAL_ROLES})
    string(TOUPPER "${role}" R)
    string(JSON d ERROR_VARIABLE derr GET "${j}" optional_inputs ${role})
    if(derr OR d STREQUAL "never")
      def(DECL_${R} 0u)
    elseif(d STREQUAL "may")
      def(DECL_${R} 1u)
    elseif(d STREQUAL "always")
      def(DECL_${R} 2u)
    else()
      message(FATAL_ERROR "fg title binding: optional_inputs.${role}: '${d}'")
    endif()
  endforeach()
  set(lmask 0)
  string(JSON nl LENGTH "${j}" tag_lifetimes)
  math(EXPR llast "${nl} - 1")
  foreach(i RANGE ${llast})
    wg_fg_json_get(lt "${j}" tag_lifetimes tag_lifetimes ${i})
    wg_fg_check_uint("tag_lifetimes" "${lt}")
    math(EXPR lmask "${lmask} | (1 << ${lt})")
  endforeach()
  def(TAG_LIFETIME_MASK ${lmask}u)

  file(RELATIVE_PATH rel "${CMAKE_CURRENT_LIST_DIR}" "${json_path}")
  set(text "// Generated at configure time by clean/fg/proxy/bindings/fg_binding_gen.cmake from ${rel} and the files it\n")
  string(APPEND text "// names. Build tree only; never edited by hand.\n#pragma once\n${L}")
  file(CONFIGURE OUTPUT "${out_header}" CONTENT "${text}" @ONLY)
  set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${deps})
endfunction()
