// SPDX-License-Identifier: MIT
// Version resource shared by WrongGPU's DLLs: identifies each file as WrongGPU's (not AMD's) in Explorer, in bug
// reports and for the install script. Included by version.rc, version_fsr3.rc and version_fsr3upscaler.rc after they
// define WG_RC_DESCRIPTION and WG_RC_FILENAME.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WRONGGPU_FSR_VERSION_RC
PRODUCTVERSION WRONGGPU_FSR_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WrongGPU project"
            VALUE "FileDescription", WG_RC_DESCRIPTION
            VALUE "FileVersion", WRONGGPU_FSR_VERSION
            VALUE "InternalName", "wronggpu-fsr"
            VALUE "OriginalFilename", WG_RC_FILENAME
            VALUE "ProductName", "WrongGPU"
            VALUE "ProductVersion", WRONGGPU_FSR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
