  "tool": "clean/l/runner/l_d3d12_profile.py (native D3D12 frame, runtime backend 3)",
  "model_and_frames": "synthetic models and synthetic frames of clean/l/runner/l_frame_check.py --prepare (no game, no real weights); pre-exposure 1.25; Model L with HDR flags, Model M without",
  "route": "the staged buffer route (the harness passes buffers, not game textures)",
  "runs": "5 rounds per shape, Model M and Model L interleaved in each round, every run in its own GPU slot, 100 profiled frames after a 3 s warm-up, then 30 timed frames",
  "timers": {
   "frame_span_ms": "whole-frame D3D12 timestamps without per-kernel timestamps (wg_rt_frame_timed): median of the 30 timed frames per run, then median over the runs",
   "dispatch_sum_ms, steps_ms, kernels_ms": "per-kernel D3D12 timestamps (WG_D3D12_PROFILE), mean over the 100 profiled frames per run, then median over the runs; the timestamps add overhead and perturb scheduling, so these are attribution, not isolated costs"
  },
  "step_map": "enc0: L's input encoder, linears, encoder block, gather / M's input encoder; dec0: L's l_dec_project + decoder block / M's d1p12 (dec1's block with the decoder fused in); post: post, filter, scale_rgb, color_divide; other: exposure; swin: the rest (L includes its own dec1 block)",
  "staged_route_only": "color_divide and scale_rgb (the pre-exposure division of the input colour and the multiply of the output) run only on the staged route; on the game's direct route the kernels fold the pre-exposure in, so the in-game frame does not run them. dispatch_sum_without_staged_route_only_ms is the profiled sum without them",
  "build": "runtime library, HIP code objects and synthetic models built from the head's sources; the D3D12 kernels (the 71 of clean/dx12/kernel_sets.json model_m + model_l) reused from a build of d5b0648, whose kernel sources (clean/dx12/kernels, hlsl, gelu_lut, f16lut) differ from the head only in frame generation kernels; three kernels rebuilt at the head (swin_block_c96_pm_rev_nc, l_post_recon_p12, lev/input_encoder_q20) are byte-identical to the reused DXILs",
  "rows": {
